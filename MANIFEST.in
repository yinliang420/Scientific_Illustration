include README.md
include LICENSE
include CHANGELOG.md
include SKILL.md
include REPO_LAYOUT.md
include pyproject.toml

recursive-include huitu *.py py.typed

# Exclude developer / test artefacts from sdist.
prune examples
prune tests
prune docs
prune reports
prune .pytest_cache
prune huitu.egg-info
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude .DS_Store
